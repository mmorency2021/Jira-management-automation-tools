# Jira Automation Configuration
# Copy this to .env and fill in your values

# Required: Your Jira credentials
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_api_token_here

# Projects you actively work on (optional — auto-detected from your assigned issues if empty)
JIRA_ACTIVE_PROJECTS=

# Projects you monitor for cross-project visibility (optional)
JIRA_WATCHED_PROJECTS=

# Stale issue thresholds (days without update)
JIRA_STALE_THRESHOLD_DAYS=14
JIRA_STALE_IN_PROGRESS_DAYS=7
JIRA_STALE_BLOCKED_DAYS=3
JIRA_STALE_REVIEW_DAYS=5

# Default board ID for sprint queries (optional)
JIRA_DEFAULT_BOARD_ID=

# Google Export (optional — set up when needed)
# GOOGLE_CREDENTIALS_FILE=credentials.json

# LLM Narrative Analysis (optional — enhances quarterly --detailed reports)
# LLM_PROVIDER=              # ollama, openai, or anthropic (leave empty to disable)
# LLM_MODEL=                 # e.g. llama3, gpt-4o-mini, claude-sonnet-4-6
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Email Reports (optional — sends standup and quarterly reports by email)
# SMTP_HOST=localhost           # default: localhost (Postfix). Use smtp.gmail.com for Gmail
# SMTP_PORT=25                  # default: 25. Use 587 for Gmail/TLS
# SMTP_USER=                    # optional: for authenticated SMTP (e.g. Gmail)
# SMTP_PASSWORD=                # optional: for authenticated SMTP
# JIRAOPS_EMAIL_RECIPIENT=your.email@company.com
# JIRAOPS_EMAIL_FROM=           # optional: sender address override

# Scheduler (optional — automatic email delivery)
# JIRAOPS_SCHEDULER_STANDUP_TIME=09:00   # daily standup email time (HH:MM)
# JIRAOPS_SCHEDULER_QUARTERLY_DAY=1      # day of month to send quarterly report (in quarter-end months)
